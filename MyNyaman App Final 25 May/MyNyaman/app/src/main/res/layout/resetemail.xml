<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/ivResetLogo"
            android:layout_width="140dp"
            android:layout_height="100dp"
            android:layout_marginStart="30dp"
            android:layout_marginTop="80dp"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_clear"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvResetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Reset via Email"
            android:textColor="#000000"
            android:textSize="38sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@+id/ivResetLogo"
            app:layout_constraintTop_toBottomOf="@+id/ivResetLogo" />

        <TextView
            android:id="@+id/tvResetSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="32dp"
            android:text="Enter the email linked to your account and we will send you a reset link."
            android:textColor="#000000"
            android:textSize="@dimen/text_subtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tvResetTitle"
            app:layout_constraintTop_toBottomOf="@+id/tvResetTitle" />

        <EditText
            android:id="@+id/etResetEmail"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="@dimen/form_margin_horizontal"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="@dimen/form_margin_horizontal"
            android:autofillHints="emailAddress"
            android:background="@drawable/rounded_input_gray"
            android:drawableStart="@drawable/ic_email"
            android:drawablePadding="16dp"
            android:hint="email"
            android:inputType="textEmailAddress"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#000000"
            android:textColorHint="#666666"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvResetSubtitle" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSendResetLink"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="@dimen/form_margin_horizontal"
            android:layout_marginTop="@dimen/button_margin_top"
            android:layout_marginEnd="@dimen/form_margin_horizontal"
            android:background="@drawable/button_blue_rounded"
            android:text="Send Reset Link"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/etResetEmail" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
