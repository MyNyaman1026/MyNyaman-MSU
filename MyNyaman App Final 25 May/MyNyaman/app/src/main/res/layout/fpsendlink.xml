<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/ivForgotLogo"
            android:layout_width="140dp"
            android:layout_height="100dp"
            android:layout_marginStart="30dp"
            android:layout_marginTop="80dp"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_clear"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvForgotTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Forgot Password"
            android:textColor="#000000"
            android:textSize="38sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@+id/ivForgotLogo"
            app:layout_constraintTop_toBottomOf="@+id/ivForgotLogo" />

        <TextView
            android:id="@+id/tvForgotSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="32dp"
            android:text="Choose how you would like to reset your password."
            android:textColor="#000000"
            android:textSize="@dimen/text_subtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tvForgotTitle"
            app:layout_constraintTop_toBottomOf="@+id/tvForgotTitle" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnResetEmail"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="@dimen/form_margin_horizontal"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="@dimen/form_margin_horizontal"
            android:background="@drawable/button_blue_rounded"
            android:text="Reset via Email"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvForgotSubtitle" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnResetPhone"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="@dimen/form_margin_horizontal"
            android:layout_marginTop="@dimen/input_margin_top"
            android:layout_marginEnd="@dimen/form_margin_horizontal"
            android:background="@drawable/button_blue_rounded"
            android:text="Reset via Phone Number"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnResetEmail" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
